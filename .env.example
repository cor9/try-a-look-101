# ---- Image generation (set one or both; OpenAI is the default when both are set,
# and users can switch engines in the Studio) ----
# Google Gemini API key — use a PAID (billing-enabled) project; free-tier data may be used to improve Google products.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# OpenAI API key (alternative provider)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2

# Force a provider instead of auto-picking: gemini | openai
# IMAGE_PROVIDER=

# ---- Photo import scanner (fills in wardrobe cards from photos) ----
# Uses Claude when ANTHROPIC_API_KEY is set, otherwise Gemini (GEMINI_API_KEY above).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_VISION_MODEL=gemini-flash-latest
# Force one: anthropic | gemini
# SCAN_PROVIDER=
# Photo scans get their own, larger allowance (an album can be dozens of photos).
SCAN_LIMIT_PER_HOUR=150
SCAN_LIMIT_PER_DAY=400

# ---- Abuse prevention & cost control ----
# Shared early-access code. When set, visitors must enter it before generating.
ACCESS_CODE=
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=60
# Stop all generation for the day once estimated spend reaches this (USD).
DAILY_BUDGET_USD=25
# Override the per-image cost estimate used for budgets and the in-app tracker.
# COST_PER_IMAGE_USD=0.14
# Salt for hashing visitor IPs in rate-limit keys.
RATE_LIMIT_SALT=change-me

# Shared counters across server instances (recommended in production).
# Vercel's Upstash Redis integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
